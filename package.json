{
  "name": "react-native-glass-tabs",
  "version": "1.0.0",
  "description": "React Native bottom tab navigator with liquid glass effect (iOS 26+), GPU-blurred frosted glass floating pill (Android), and Material 3 native tabs. Drop-in replacement for @react-navigation/bottom-tabs with glassmorphism, SF Symbols, badges, dark mode, and adaptive fallbacks. Single <GlassTabs> component for all platforms.",
  "main": "src/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/generated",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "build:dist": "bash scripts/build-dist.sh",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\"",
    "prepack": "npm run build",
    "release": "release-it",
    "format": "prettier --write \"src/**/*.tsx\"",
    "clean": "del-cli lib android/build"
  },
  "keywords": [
    "react-native",
    "react-native-bottom-tabs",
    "bottom-tabs",
    "glass-tabs",
    "liquid-glass",
    "glassmorphism",
    "bottom-navigation",
    "tab-bar",
    "tab-navigator",
    "floating-tabs",
    "floating-pill",
    "blur",
    "blur-view",
    "translucent",
    "frosted-glass",
    "gpu-blur",
    "render-effect",
    "ios",
    "ios-26",
    "ios26",
    "android",
    "material-design",
    "material3",
    "sf-symbols",
    "swiftui",
    "kotlin",
    "turbomodule",
    "new-architecture",
    "fabric",
    "react-navigation",
    "react-navigation-bottom-tabs",
    "native-tabs",
    "bottom-bar",
    "navigation-bar",
    "expo",
    "adaptive-tabs",
    "cross-platform-tabs",
    "glass-effect",
    "glass-tab-bar",
    "telegram-tabs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/louaySleman/react-native-glass-tabs.git"
  },
  "author": "louay <louayakram12@hotmail.com> (https://github.com/louaySleman)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/louaySleman/react-native-glass-tabs/issues"
  },
  "homepage": "https://github.com/louaySleman/react-native-glass-tabs#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native-community/eslint-config": "^3.0.2",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "^0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.0.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.6.3",
    "prettier": "^2.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.20.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "release-it": "^15.0.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=7.0.0",
    "@react-navigation/native": ">=7.0.0",
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "@bottom-tabs/react-navigation": {
      "optional": true
    },
    "@react-navigation/native-stack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 18"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example",
      "<rootDir>/dist",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "dist/",
    "example/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "node_modules/.bin/tsc"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNGlassTabsSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.glasstabs"
    }
  },
  "packageManager": "yarn@3.6.4"
}
